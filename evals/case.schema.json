{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiuDog/agentic-workflow-setup/evals/case.schema.json",
  "title": "Agent skill evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "purpose",
    "owner",
    "non_goals",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$"
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "owner": {
      "type": "string",
      "minLength": 10
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "mode",
        "prompt",
        "expected_owner",
        "selection_rule",
        "checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        },
        "kind": {
          "enum": [
            "positive",
            "negative",
            "collision",
            "behavior"
          ]
        },
        "mode": {
          "enum": [
            "routing",
            "behavior"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 10
        },
        "expected_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_rule": {
          "enum": [
            "exact",
            "exclude-target"
          ]
        },
        "fixture": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "verifier",
        "required",
        "criterion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "routing",
            "behavior"
          ]
        },
        "verifier": {
          "enum": [
            "machine",
            "evaluator",
            "human"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "criterion": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
