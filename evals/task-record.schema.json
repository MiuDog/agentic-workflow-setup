{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/MiuDog/agentic-workflow-setup/evals/task-record.schema.json",
	"title": "Local task registry record envelope",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"record_status",
		"source",
		"task"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"record_status": {
			"enum": [
				"pending",
				"finalized"
			]
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"summary_path",
				"summary_sha256",
				"evidence",
				"case_id",
				"variant",
				"iteration"
			],
			"properties": {
				"summary_path": {
					"type": "string",
					"minLength": 1
				},
				"summary_sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				"evidence": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"path",
							"sha256"
						],
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1
							},
							"sha256": {
								"type": "string",
								"pattern": "^[a-f0-9]{64}$"
							}
						}
					}
				},
				"case_id": {
					"type": "string",
					"minLength": 1
				},
				"variant": {
					"enum": [
						"baseline",
						"treatment"
					]
				},
				"iteration": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"task": {
			"$ref": "task-registry.schema.json#/$defs/task"
		}
	}
}
